          "name": "Get All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=10&searchTerm=",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "searchTerm",
                  "value": ""
                }
              ]
            },
            "description": "Retrieve list of all registered users (Admin permission required)."
          }
        },
        {
          "name": "Get Single User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/single/:id",
              "host": ["{{baseUrl}}"],
              "path": ["users", "single", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "USER_ID_HERE"
                }
              ]
            },
            "description": "Get detailed info of a user by User ID."
          }
        },
        {
          "name": "Update User (Admin)",
          "request": {
            "method": "PATCH",
