                  "value": "{\n  \"hasBussiness\": true,\n  \"fundingAmount\": 50000,\n  \"credit\": \"Excellent\",\n  \"useCase\": \"Business Expansion\",\n  \"hasBank\": true,\n  \"loanUser\": {\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"phone\": \"+1234567890\"\n  },\n  \"business\": {\n    \"businessName\": \"Acme Enterprises\",\n    \"startMonth\": \"01\",\n    \"startDate\": \"15\",\n    \"startYear\": \"2020\",\n    \"annualRevenue\": 300000,\n    \"legalEntity\": \"LLC\",\n    \"industryType\": \"Technology\",\n    \"dbaName\": \"Acme Tech\",\n    \"B_phone\": \"+1987654321\",\n    \"B_address\": \"100 Innovation Way\",\n    \"EIN_code\": \"12-3456789\",\n    \"B_city\": \"San Francisco\",\n    \"B_state\": \"CA\",\n    \"B_zipCode\": \"94105\",\n    \"businessOwner\": [\n      {\n        \"FullName\": \"John Doe\",\n        \"SSN\": \"123-45-6789\",\n        \"month\": \"05\",\n        \"day\": \"20\",\n        \"year\": \"1985\",\n        \"email\": \"john.doe@example.com\",\n        \"phone\": \"+1234567890\",\n        \"ownerParcentage\": \"100%\",\n        \"address\": \"456 Residence Lane\",\n        \"city\": \"San Francisco\",\n        \"state\": \"CA\",\n        \"zipcode\": \"94105\",\n        \"signature\": \"https://example.com/signature.png\"\n      }\n    ]\n  }\n}",
