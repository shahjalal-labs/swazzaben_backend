              "path": ["users", "otp-resend"]
            },
            "description": "Resend OTP code for pending registration."
          }
        },
        {
          "name": "Verify OTP & Finalize Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"johndoe@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/create",
              "host": ["{{baseUrl}}"],
              "path": ["users", "create"]
            },
            "description": "Step 2 of registration: verifies OTP and creates active user in database."
          }
        },
        {
          "name": "Social Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"Jane Doe\",\n  \"email\": \"janedoe@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/social-login",
              "host": ["{{baseUrl}}"],
              "path": ["users", "social-login"]
