              "mode": "formdata",
              "formdata": [
                {
                  "key": "profileImage",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "bodyData",
                  "value": "{\n  \"userName\": \"Updated User Name\",\n  \"phone\": \"+1987654321\",\n  \"address\": \"456 Elm Street\"\n}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/users/update-user/:userId",
              "host": ["{{baseUrl}}"],
              "path": ["users", "update-user", ":userId"],
              "variable": [
                {
                  "key": "userId",
                  "value": "USER_ID_HERE"
                }
              ]
            },
            "description": "Update specific user details as Admin."
          }
        },
        {
          "name": "Delete User (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
